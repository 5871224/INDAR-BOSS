[Unit]
Description=INDAR-SOYAL settings API
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=indar
Group=indar
WorkingDirectory=/home/indar/deploy/INDAR-SOYAL
EnvironmentFile=/etc/indar-soyal/database.env
ExecStart=/usr/local/bin/node /home/indar/deploy/INDAR-SOYAL/server.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/indar/deploy/INDAR-SOYAL

[Install]
WantedBy=multi-user.target
